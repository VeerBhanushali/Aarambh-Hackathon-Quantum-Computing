# Quantum Guard — Full-Stack Next.js Environment Configuration
# Deploy `web/` as Root Directory on Vercel -> quantumguard-lab.veerbhanushali.in
APP_DOMAIN=quantumguard-lab.veerbhanushali.in

# Supabase PostgreSQL Cloud (Project: irjstudhbbjtnxqulriw, Region: ap-south-1)
SUPABASE_URL=https://irjstudhbbjtnxqulriw.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Session & RBAC JWT Secret (CISO, SecOps, PKI Admin, Auditor)
QG_JWT_SECRET=change_me_in_production

# Resend Email API (For Sending Unlocked PDF/HTML Executive Reports)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Quantum Guard <reports@quantumguard-lab.veerbhanushali.in>

# Docker OpenSSL 3.5 Worker Endpoint (Render / Railway / Cloud Run / Cloudflare Container)
# When set, Next.js API routes delegate C-level OpenSSL 3.5 PQC operations (ML-KEM-768, ML-DSA-65, SLH-DSA)
# to your Docker OpenSSL 3.5 worker container; if unset, Next.js falls back to native Node.js TLS/Crypto.
OPENSSL_WORKER_URL=http://127.0.0.1:8000
